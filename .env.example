# Copy this file to .env and fill in your keys. Do NOT put real keys in this file.

# --- AI provider (one of the two is required for Snap & Ask) ---
# Gemini (free tier): create keys at https://aistudio.google.com
# Any variable starting with GEMINI_API_KEY is used; multiple keys rotate
# automatically when one hits its daily free-tier limit.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# Optional model override (default gemini-2.5-flash):
# GEMINI_MODEL=gemini-2.5-flash

# Claude (paid, used only when no Gemini key is set):
# https://platform.claude.com/
ANTHROPIC_API_KEY=

# --- Google Images (optional, better component photos; free 100 searches/day) ---
# 1) API key: https://developers.google.com/custom-search/v1/overview -> "Get a key"
# 2) Engine:  https://programmablesearchengine.google.com -> Create ->
#    "Search the entire web" ON + "Image search" ON -> copy the "Search engine ID"
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# --- Data sources ---
# Optional: openFDA works without a key but allows more requests with one.
# Free key at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# --- Persistent file storage (Cloudinary, optional) ---
# Dashboard: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_URL=

# --- Database (Postgres, e.g. Neon). Blank = local SQLite. ---
DATABASE_URL=

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Production only (e.g. on Vercel) — leave blank for local dev:
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=your-app.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
